{
  "name": "dynamic-island-windows",
  "version": "0.4.0",
  "author": "Juls",
  "description": "Dynamic Island untuk Windows",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --publish never" },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "id.dynamicisland.win",
    "productName": "Dynamic Island",
    "files": ["main.js", "preload.js", "index.html", "assets/**", "helper/**"],
    "asarUnpack": ["helper/**"],
    "win": { "target": "nsis", "icon": "assets/icon.png" }
  }
}
